function getCompanyLogo() {
  return Utilities.newBlob(
    Utilities.base64Decode(COMPANY_LOGO_BASE64),
    'image/png',
    'careerbridge-foundation-logo.png'
  );
}

function wrapEmail(content) {
  const website = /^https:\/\/\S+$/i.test(COMPANY.website)
    ? '<a href="' + escapeHtml(COMPANY.website) + '" style="color:' + COMPANY.color + ';text-decoration:none;">' +
      escapeHtml(COMPANY.website.replace(/^https:\/\//i, '')) + '</a>'
    : '';

  return '<div style="margin:0;padding:28px 12px;background:#F1F5F9;font-family:-apple-system,BlinkMacSystemFont,\'Segoe UI\',Roboto,Helvetica,Arial,sans-serif;">' +
    '<table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" ' +
      'style="width:100%;max-width:600px;margin:0 auto;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:18px;overflow:hidden;box-shadow:0 10px 25px -5px rgba(6,29,66,0.06);">' +
      // Header with CareerBridge Logo & Orange Stripe
      '<tr><td style="padding:28px 24px 22px;background:#FFFFFF;text-align:center;border-bottom:4px solid ' + COMPANY.accent + ';">' +
        '<img src="cid:careerbridgeLogo" width="230" alt="' + escapeHtml(COMPANY.name) +
          '" style="display:block;width:230px;max-width:100%;height:auto;margin:0 auto;border:0;">' +
        '<div style="margin-top:10px;color:#64748b;font-size:12px;font-weight:600;letter-spacing:0.3px;">' + escapeHtml(COMPANY.tagline) + '</div>' +
      '</td></tr>' +
      // Dynamic Body Content
      content +
      // Footer with CareerBridge Branding
      '<tr><td style="padding:22px 24px 24px;background:#F8FAFC;text-align:center;border-top:1px solid #E2E8F0;">' +
        '<div style="font-size:14px;font-weight:800;color:' + COMPANY.color + ';letter-spacing:0.2px;">' + escapeHtml(COMPANY.name) + '</div>' +
        '<div style="margin-top:4px;color:' + COMPANY.accent + ';font-size:12px;font-weight:600;">' + escapeHtml(COMPANY.tagline) + '</div>' +
        '<div style="margin-top:10px;font-size:12px;line-height:1.9;color:#64748b;">' +
          escapeHtml(COMPANY.address) + '<br>' +
          '<a href="mailto:' + escapeHtml(COMPANY.email) + '" style="color:' + COMPANY.color + ';text-decoration:none;font-weight:600;">' +
            escapeHtml(COMPANY.email) + '</a> | ' + escapeHtml(COMPANY.phone) +
          (website ? '<br>' + website : '') +
        '</div>' +
        '<div style="margin-top:14px;color:#94a3b8;font-size:11px;">This is an automated notification from the CareerBridge Foundation portal.</div>' +
      '</td></tr>' +
    '</table>' +
  '</div>';
}

function emailRow(label, value) {
  return '<tr><td style="padding:11px 12px 11px 0;width:125px;border-bottom:1px solid #F1F5F9;color:#64748b;font-size:13px;vertical-align:top;">' + label +
    '</td><td style="padding:11px 0;border-bottom:1px solid #F1F5F9;color:#0F172A;font-size:14px;font-weight:600;vertical-align:top;">' + value + '</td></tr>';
}

function escapeHtml(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function createContactResponse(result) {
  const payload = JSON.stringify({
    type: 'CAREERBRIDGE_CONTACT_RESULT',
    result: result
  })
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026');

  const html = '<!DOCTYPE html>' +
    '<html>' +
      '<body>' +
        '<script>' +
          'const result = ' + payload + ';' +
          'window.parent.postMessage(result, "*");' +
          'if (window.top !== window.parent) {' +
            'window.top.postMessage(result, "*");' +
          '}' +
        '<\/script>' +
        'Submission processed.' +
      '</body>' +
    '</html>';

  return HtmlService.createHtmlOutput(html)
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
