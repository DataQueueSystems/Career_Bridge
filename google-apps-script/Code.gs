      '<div style="margin-top:8px;padding:16px 20px;background:#F8FAFC;border:1px solid #E2E8F0;border-left:4px solid ' + COMPANY.accent + ';border-radius:8px;color:#334155;font-size:14px;line-height:1.8;">' +
        escapeHtml(data.message).replace(/\n/g, '<br>') +
      '</div>' +
    '</td></tr>';

  MailApp.sendEmail({
    to: OWNER_EMAIL,
    replyTo: data.email,
    subject: 'New enquiry from ' + data.name + ' (' + data.role + ')',
    body: 'New website enquiry\n\nName: ' + data.name + '\nEmail: ' + data.email +
      '\nPhone: ' + (data.phone || '-') + '\nRole: ' + data.role + '\n\nMessage:\n' + data.message,
    htmlBody: wrapEmail(content),
    inlineImages: { careerbridgeLogo: getCompanyLogo() },
    name: COMPANY.name + ' Website'
  });
}

