/**
 * Robust sheet finder:
 * Searches for exact or case-insensitive tab name,
 * and automatically creates the tab with styled headers if not found.
 */
function getOrCreateSheet(sheetName, headers) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const cleanTarget = String(sheetName || '').trim().toLowerCase();
  
  // 1. Try exact match
  let sheet = ss.getSheetByName(sheetName);
  
  // 2. Try case-insensitive and trimmed match across existing tabs
  if (!sheet) {
    const allSheets = ss.getSheets();
    for (let i = 0; i < allSheets.length; i++) {
      if (allSheets[i].getName().trim().toLowerCase() === cleanTarget) {
        sheet = allSheets[i];
        break;
      }
    }
  }

  // 3. Auto-create if not found
  if (!sheet) {
    sheet = ss.insertSheet(sheetName);
    if (headers && headers.length) {
      sheet.appendRow(headers);
      const headerRange = sheet.getRange(1, 1, 1, headers.length);
      headerRange.setFontWeight('bold');
      headerRange.setBackground('#061D42');
      headerRange.setFontColor('#FFFFFF');
    }
  }
  return sheet;
}

/**
 * Web App entry point: receives POST submissions from CareerBridge website
 */
function doPost(e) {
  const submissionId = String(e && e.parameter && e.parameter.submissionId || '');
  let data = e && e.parameter ? e.parameter : {};

  // Parse raw JSON if payload was submitted as application/json
  if (e && e.postData && e.postData.contents) {
    try {
      const parsed = JSON.parse(e.postData.contents);
      if (parsed && typeof parsed === 'object') {
        data = Object.assign({}, data, parsed);
      }
    } catch (err) {}
  }

  // Detect form type from explicit parameter, or auto-detect from submitted fields
  let formType = String(data.formType || '').trim().toLowerCase();
  if (!formType) {
    if (data.yearOfCompletion || data.semester || data.status) {
      formType = 'skill_development';
    } else if (data.qualification || data.customQualification || data.place) {
      formType = 'job';
    } else {
      formType = 'contact';
    }
  }

  try {
    // =============================================================
    // 1. Handle Job Applications -> Saves to 'Job Applications' tab
    // =============================================================
    if (formType === 'job') {
      const name = String(data.name || '').trim();
      const place = String(data.place || '').trim();
      const phone = String(data.phone || '').trim();
      const email = String(data.email || '').trim();
      const qualification = String(data.customQualification || data.qualification || '').trim();

      if (!name || name.length < 2 || name.length > 80) {
        throw new Error('Enter a valid name between 2 and 80 characters.');
      }
      if (!place || place.length < 2 || place.length > 100) {
        throw new Error('Enter a valid place/location.');
      }
      if (!phone || (phone.match(/[0-9]/g) || []).length < 7 || (phone.match(/[0-9]/g) || []).length > 15) {
        throw new Error('Enter a valid contact number (7–15 digits).');
      }
      if (!email || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        throw new Error('Enter a valid email address.');
      }
      if (!qualification) {
        throw new Error('Please select or enter your qualification.');
      }

      // TARGET: 'Job Applications' sheet
      const jobSheet = getOrCreateSheet('Job Applications', [
        'Timestamp', 'Submission ID', 'Full Name', 'Place', 'Contact', 'Email', 'Qualification'
      ]);

      const lock = LockService.getScriptLock();
      lock.waitLock(10000);
      try {
        jobSheet.appendRow([
          new Date(), submissionId, name, place, phone, email, qualification
        ]);
      } finally {
        lock.releaseLock();
      }

      // Send Admin Alert Email
      try {
        sendJobOwnerEmail({
          submissionId: submissionId,
          name: name,
          place: place,
          phone: phone,
          email: email,
          qualification: qualification
        });
      } catch (err) {
        console.error('Job owner email error: ' + err);
      }

      // Send Applicant Confirmation Email
      try {
        sendJobUserConfirmationEmail({
          submissionId: submissionId,
          name: name,
          place: place,
          phone: phone,
          email: email,
          qualification: qualification
        });
      } catch (err) {
        console.error('Job applicant email error: ' + err);
      }

      return createContactResponse({
        success: true,
        saved: true,
        submissionId: submissionId,
        message: 'Your job application has been submitted successfully to Job Applications.'
      });
    }

    // =============================================================
    // 2. Handle Skill Development -> Saves to 'Skill Development' tab
    // =============================================================
    if (formType === 'skill_development') {
      const name = String(data.name || '').trim();
      const place = String(data.place || '').trim();
      const phone = String(data.phone || '').trim();
      const email = String(data.email || '').trim();
      const qualification = String(data.qualification || '').trim();
      let yearOfCompletion = String(data.yearOfCompletion || data.status || '').trim();
      if (!yearOfCompletion) yearOfCompletion = 'Pursuing';
      const semester = String(data.semester || '').trim();

      if (!name || name.length < 2 || name.length > 80) {
        throw new Error('Enter a valid name between 2 and 80 characters.');
      }
      if (!place || place.length < 2 || place.length > 100) {
        throw new Error('Enter a valid place/location.');
      }
      if (!phone || (phone.match(/[0-9]/g) || []).length < 7 || (phone.match(/[0-9]/g) || []).length > 15) {
        throw new Error('Enter a valid contact number (7–15 digits).');
      }
      if (!email || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        throw new Error('Enter a valid email address.');
      }
      if (!qualification) {
        throw new Error('Please select your qualification.');
      }

      // TARGET: 'Skill Development' sheet
      const skillSheet = getOrCreateSheet('Skill Development', [
        'Timestamp', 'Submission ID', 'Full Name', 'Place', 'Contact', 'Email', 'Qualification', 'Year of Completion / Status', 'Semester'
      ]);

      const lock = LockService.getScriptLock();
      lock.waitLock(10000);
      try {
        skillSheet.appendRow([
          new Date(), submissionId, name, place, phone, email, qualification, yearOfCompletion, semester
        ]);
      } finally {
        lock.releaseLock();
      }

      // Send Admin Alert Email
      try {
        sendSkillOwnerEmail({
          submissionId: submissionId,
          name: name,
          place: place,
          phone: phone,
          email: email,
          qualification: qualification,
          yearOfCompletion: yearOfCompletion,
          semester: semester
        });
      } catch (err) {
        console.error('Skill owner email error: ' + err);
      }

      // Send Applicant Confirmation Email
      try {
        sendSkillUserConfirmationEmail({
          submissionId: submissionId,
          name: name,
          place: place,
          phone: phone,
          email: email,
          qualification: qualification,
          yearOfCompletion: yearOfCompletion,
          semester: semester
        });
      } catch (err) {
        console.error('Skill applicant email error: ' + err);
      }

      return createContactResponse({
        success: true,
        saved: true,
        submissionId: submissionId,
        message: 'Your skill development application has been submitted successfully to Skill Development.'
      });
    }

    // =============================================================
    // 3. Default: Handle Contact Enquiries -> Saves to 'Enquiries' tab
    // =============================================================
    // TARGET: 'Enquiries' sheet
    const contactSheet = getOrCreateSheet('Enquiries', [
      'NAME', 'EMAIL', 'PHONE', 'I AM', 'MESSAGE'
    ]);

    const name = String(data.name || '').trim();
    const email = String(data.email || '').trim();
    const phone = String(data.phone || '').trim();
    const role = String(data.role || 'Other').trim();
    const message = String(data.message || '').trim();

    if (!name || name.length < 2 || name.length > 80) {
      throw new Error('Enter a name between 2 and 80 characters.');
    }
    if (!email || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      throw new Error('Enter a valid email address.');
    }
    if (phone && (!/^\+?[0-9\s().-]{7,20}$/.test(phone) ||
        (phone.match(/[0-9]/g) || []).length < 7 ||
        (phone.match(/[0-9]/g) || []).length > 15)) {
      throw new Error('Enter a phone number containing 7–15 digits.');
    }
    if (message.length < 5 || message.length > 2000) {
      throw new Error('Enter a message between 5 and 2,000 characters.');
    }

    const lock = LockService.getScriptLock();
    lock.waitLock(10000);
    try {
      if (isDuplicateEnquiry(contactSheet, email, phone)) {
        return createContactResponse({
          success: false,
          saved: false,
          duplicate: true,
          submissionId: submissionId,
          message: 'You have already submitted an enquiry with this email address and mobile number.'
        });
      }

      contactSheet.appendRow([name, email, phone, role, message]);
    } finally {
      lock.releaseLock();
    }

    let adminEmailSent = false;
    let userEmailSent = false;

    try {
      sendContactOwnerEmail({ name: name, email: email, phone: phone, role: role, message: message });
      adminEmailSent = true;
    } catch (error) {
      console.error('Owner email error: ' + error);
    }

    try {
      sendContactUserConfirmationEmail({ name: name, email: email, message: message });
      userEmailSent = true;
    } catch (error) {
      console.error('Confirmation email error: ' + error);
    }

    return createContactResponse({
      success: true,
      saved: true,
      submissionId: submissionId,
      userEmailSent: userEmailSent,
      adminEmailSent: adminEmailSent,
      message: 'Your enquiry has been recorded in Enquiries.'
    });
  } catch (error) {
    console.error(error);

    return createContactResponse({
      success: false,
      saved: false,
      submissionId: submissionId,
      message: error && error.message
        ? error.message
        : 'Unable to process your request.'
    });
  }
}

/**
 * Check for duplicate general enquiry
 */
function isDuplicateEnquiry(sheet, email, phone) {
  const normalizedEmail = String(email || '').trim().toLowerCase();
  const normalizedPhone = String(phone || '').replace(/\D/g, '');
  const lastRow = sheet.getLastRow();

  if (!normalizedEmail || !normalizedPhone || lastRow < 1) {
    return false;
  }

  const existingEnquiries = sheet.getRange(1, 2, lastRow, 2).getDisplayValues();
  return existingEnquiries.some(function (row) {
    return String(row[0] || '').trim().toLowerCase() === normalizedEmail &&
      String(row[1] || '').replace(/\D/g, '') === normalizedPhone;
  });
}

